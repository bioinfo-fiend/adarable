manifest {
    name            = 'adarable'
    description     = 'ADARable: A-to-I RNA editing: FASTQ -> STAR 2-pass -> REDItools3 -> editing index'
    version         = '0.1.0'
    nextflowVersion = '>=25.04'
    mainScript      = 'main.nf'
}

params {
    input  = null
    outdir = 'results'
    genome = 'GRCh38'
}

def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }

process {
    cpus   = 2
    memory = 4.GB

    withName: CHECK_SAMPLESHEET {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy', pattern: '*.csv']
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    test { includeConfig 'conf/test.config' }
}

