manifest {
    name            = 'adarable'
    description     = 'ADARable: A-to-I RNA editing: FASTQ -> STAR 2-pass -> REDItools3 -> editing index'
    version         = '0.1.0'
    nextflowVersion = '>=25.04'
    mainScript      = 'main.nf'
}

params {
    input  = null
    outdir = 'results'

    // References: --genome fills these from conf/genomes.config / -c conf/local.config; any can be overridden
    genome           = null
    fasta            = null
    gtf              = null
    star_index       = null   // prebuilt STAR index dir(s); the one matching read_length is used, else built and cached
    dbsnp            = null
    dbsnp_index      = null
    repeats          = null   // UCSC rmsk.txt(.gz) or a ready BED
    repeat_families  = null
    rediportal       = null   // REDIportal TABLE1
    rediportal_chain = null   // liftOver chain when REDIportal is on another assembly
    ref_cache        = 'ref_cache'   // prepared references are stored here and reused across runs
    read_length      = 150    // STAR sjdbOverhang = read_length - 1

    // fastp (phase 03)
    adapter_fasta    = null   // extra adapters, e.g. MGI/DNBSEQ; Illumina ones are auto-detected
    umi_loc          = null   // fastp --umi_loc (read1, read2, index1, per_read, ...), or 'header' when the
                              // FASTQ read names already end in :UMI (Illumina BCL Convert); off when null
    umi_len          = null

    // SortMeRNA: % rRNA in MultiQC; --remove_rrna also maps only the non-rRNA reads
    rrna_db           = null      // rRNA FASTA, e.g. smr_v4.3_fast_db.fasta from the SortMeRNA release
    skip_rrna_check   = false
    remove_rrna       = false
    rrna_reads        = 2000000   // reads (pairs) checked when only reporting % rRNA

    node = null   // -profile slurm: pin every task to this node (node-local work dir, repo or ref cache)
}

includeConfig 'conf/genomes.config'

def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }

process {
    cpus   = 2
    memory = 4.GB

    withName: STAR_GENOMEGENERATE {
        cpus   = 8
        memory = 40.GB
    }
    withName: STAR_ALIGN {
        cpus   = 8
        memory = 64.GB
        publishDir = [path: params.outdir, mode: 'copy', saveAs: { f -> f.endsWith('.Log.final.out') ? "stats/star/${f}" : f.endsWith('.SJ.out.tab') ? "junctions/${f}" : null }]
    }
    withName: 'FASTP|SAMTOOLS_MARKDUP|BAMCOVERAGE' {
        cpus   = 8
        memory = 16.GB
    }
    withName: UMITOOLS_DEDUP {
        memory = 32.GB
    }
    withName: 'SAMTOOLS_MARKDUP|UMITOOLS_DEDUP' {
        publishDir = [path: params.outdir, mode: 'copy', saveAs: { f -> f.endsWith('.bam') || f.endsWith('.bai') ? "bam/${f}" : f == 'versions.yml' ? null : "stats/dedup/${f}" }]
    }
    withName: SAMTOOLS_STATS {
        publishDir = [path: "${params.outdir}/stats/samtools", mode: 'copy', pattern: '*.{stats,flagstat}']
    }
    withName: INFER_STRAND {
        publishDir = [path: "${params.outdir}/stats/strandedness", mode: 'copy', saveAs: { f -> f == 'strand.txt' ? "${meta.id}.strand.txt" : f.endsWith('.txt') ? f : null }]
    }
    withName: BAMCOVERAGE {
        publishDir = [path: "${params.outdir}/bigwig", mode: 'copy', pattern: '*.bw']
    }
    withName: 'SORTMERNA|PREP_SORTMERNA_INDEX' {
        cpus   = 8
        memory = 16.GB
    }
    withName: SORTMERNA {
        publishDir = [path: "${params.outdir}/stats/sortmerna", mode: 'copy', pattern: '*.{log,tsv}']
    }
    withName: FASTQC {
        publishDir = [path: "${params.outdir}/fastqc", mode: 'copy', pattern: '*.{html,zip}']
    }
    withName: FASTP {
        publishDir = [path: "${params.outdir}/fastp", mode: 'copy', pattern: '*.{html,json}']
    }
    withName: MULTIQC {
        publishDir = [path: params.outdir, mode: 'copy', saveAs: { f -> f == 'versions.yml' ? null : f == 'sequencing_stats.tsv' ? "stats/${f}" : "multiqc/${f}" }]
    }
    withName: CHECK_SAMPLESHEET {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy', pattern: '*.csv']
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = { params.node ? "--nodelist=${params.node}" : '' }
    }
    test { includeConfig 'conf/test.config' }
}

