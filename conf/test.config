params {
    input       = "${projectDir}/assets/test_samplesheet.csv"
    outdir      = 'results'
    genome      = 'test_rnavar'
    read_length = 142
    // small SortMeRNA database (5.8S, Rfam); real runs use the full smr_v4.3 fast/default DB
    rrna_db     = 'https://raw.githubusercontent.com/sortmerna/sortmerna/v4.3.7/data/rRNA_databases/rfam-5.8s-database-id98.fasta'
}
process {
    resourceLimits = [cpus: 2, memory: 4.GB]
}
