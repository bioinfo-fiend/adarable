// Your own references. Copy to conf/local.config (git-ignored), edit the paths, then
//   nextflow run main.nf -profile docker -c conf/local.config --genome GRCh38 --input samples.csv
// Only fasta and gtf are required; leave out the rest and those steps are skipped.
// Keep chromosome naming (chr1 vs 1) the same across files.
params.genomes['GRCh38'] = [
    fasta          : '/path/to/GRCh38.primary_assembly.fa',   // .fa or .fa.gz
    gtf            : '/path/to/annotation.gtf',                // .gtf or .gtf.gz, same assembly as fasta
    // star_index  : ['/path/to/star_oh99', '/path/to/star_oh149'], // prebuilt; the one matching --read_length is used, else one is built
    // repeats     : '/path/to/alu.bed',                      // a ready BED, or a UCSC rmsk.txt(.gz)
    // repeat_families: 'Alu',                                 // only used with rmsk; mouse: 'Alu,B2'
    // dbsnp       : '/path/to/dbsnp.vcf.gz', dbsnp_index: '/path/to/dbsnp.vcf.gz.tbi',
    // rediportal  : '/path/to/TABLE1_hg38_v3.txt.gz',
    // rediportal_chain: '/path/to/mm10ToMm39.over.chain.gz', // when REDIportal is on another assembly
]
params.ref_cache = '/path/to/adarable_ref_cache'   // prepared FASTA, STAR index, BEDs; reused across runs
params.rrna_db   = '/path/to/smr_v4.3_fast_db.fasta'  // SortMeRNA rRNA database (from the SortMeRNA v4.3 release)
