// Use your own local references instead of the cloud defaults.
//   cp conf/local.example.config conf/local.config   (git-ignored), edit the paths, then
//   nextflow run main.nf -profile docker -c conf/local.config --input samples.csv
// Anything left out falls back to the `base` cloud entry. Chromosome naming (chr1 vs 1) may differ between files.
params.genomes['GRCh38_local'] = [
    base       : 'GRCh38',   // anything not set here comes from the cloud GRCh38 entry
    fasta      : '/path/to/GRCh38.primary_assembly.fa',      // .fa or .fa.gz
    gtf        : '/path/to/annotation.gtf',                   // .gtf or .gtf.gz, same assembly as fasta
    // star_index: '/path/to/star_index_dir',                // optional, skips building one
    // repeats   : '/path/to/rmsk.txt.gz',                   // UCSC rmsk table, or a ready BED
    // dbsnp     : '/path/to/dbsnp.vcf.gz', dbsnp_index: '/path/to/dbsnp.vcf.gz.tbi',
    // rediportal: '/path/to/TABLE1_hg38_v3.txt.gz',
]
params.genome    = 'GRCh38_local'
params.ref_cache = '/path/to/adarable_ref_cache'   // prepared FASTA, STAR index, BEDs; reused across runs
