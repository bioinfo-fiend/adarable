// Public reference locations, read straight from the cloud; nothing is stored in this repo.
// Override any entry with --fasta, --gtf, ... or a -c config pointing at local copies.
// Chromosome names may differ between files (chr1 vs 1); phase 06 normalises them when comparing.
params.genomes = [
    'GRCh38': [
        fasta           : 'https://storage.googleapis.com/gcp-public-data--broad-references/hg38/v0/GRCh38.primary_assembly.genome.fa',
        gtf             : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.primary_assembly.annotation.gtf.gz',
        dbsnp           : 'https://storage.googleapis.com/gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.gz',
        dbsnp_index     : 'https://storage.googleapis.com/gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.gz.tbi',
        repeats         : 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/database/rmsk.txt.gz',
        repeat_families : 'Alu',
        rediportal      : 'https://rediportal.cloud.ba.infn.it/download/TABLE1_hg38_v3.txt.gz',
        rediportal_chain: null,
    ],
    'GRCm39': [
        fasta           : 'https://storage.googleapis.com/gcp-public-data--broad-references/GRCm39/GRCm39.primary_assembly.genome.fa.gz',
        gtf             : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M39/gencode.vM39.primary_assembly.annotation.gtf.gz',
        dbsnp           : 'https://ftp.ensembl.org/pub/current_variation/vcf/mus_musculus/mus_musculus.vcf.gz',
        dbsnp_index     : 'https://ftp.ensembl.org/pub/current_variation/vcf/mus_musculus/mus_musculus.vcf.gz.csi',
        repeats         : 'https://hgdownload.soe.ucsc.edu/goldenPath/mm39/database/rmsk.txt.gz',
        repeat_families : 'Alu,B2',   // mouse B1 elements are filed under repFamily "Alu" in UCSC rmsk
        rediportal      : 'https://rediportal.cloud.ba.infn.it/download/TABLE1_mm10_v3.txt.gz',
        rediportal_chain: 'https://hgdownload.soe.ucsc.edu/goldenPath/mm10/liftOver/mm10ToMm39.over.chain.gz',
    ],
    // 40 kb chr22 slice matching assets/test reads (nf-core/test-datasets, MIT)
    'test_rnavar': [
        fasta           : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/genome.fasta',
        gtf             : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/genome.gtf',
        dbsnp           : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz',
        dbsnp_index     : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi',
        repeats         : null,   // spike-in truth set added in phase 05
        repeat_families : 'Alu',
        rediportal      : null,
        rediportal_chain: null,
    ],
]
