// Only the bundled test slice lives here. Real genomes are local: see conf/local.example.config.
params.genomes = [
    // 40 kb chr22 slice matching assets/test reads (nf-core/test-datasets, MIT)
    'test_rnavar': [
        fasta      : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/genome.fasta',
        gtf        : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/genome.gtf',
        dbsnp      : 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz',
        dbsnp_index: 'https://raw.githubusercontent.com/nf-core/test-datasets/rnavar/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi',
        // repeats / rediportal: spike-in truth set added in phase 05
    ],
]
